Screen {
    layout: vertical;
}

#main-panel {
    width: 100%;
    height: 1fr;
    overflow-y: auto;

    border: solid cyan;

    padding: 1 2;
    margin: 0;
}

.title {
    width: 100%;

    content-align: center middle;
    text-style: bold;

    margin-bottom: 1;
}

.section-title {
    width: 100%;

    text-style: bold;

    margin-top: 1;
    margin-bottom: 1;

    border-bottom: solid cyan;
    padding-bottom: 1;
}

/* =========================
   ALIGNMENT DASHBOARD
   ========================= */

#alignment-progress-label {
    width: 100%;
    margin-top: 1;
}

#chunk-pair {
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

#alignment_progress {
    width: 100%;
    margin-bottom: 2;
}


/* =========================
   GPU STATUS
   ========================= */

#gpu-status,
#gpu-memory,
#gpu-utilization,
#cuda-status {
    width: 100%;
    margin-top: 1;
    padding: 1;
    border: round cyan;
}


/* =========================
   RESULTS
   ========================= */

#cpu-result-title,
#gpu-result-title {
    width: 100%;

    text-style: bold;

    margin-top: 1;
    margin-bottom: 1;
}

#cpu-average-time,
#cpu-throughput,
#gpu-average-time,
#gpu-throughput,
#gpu-speedup {
    width: 100%;
    margin-top: 1;
}


/* =========================
   GENOME CHUNKING
   ========================= */

#chunk_progress {
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

#status {
    width: 100%;

    margin-top: 1;
    margin-bottom: 1;

    padding: 1;

    border: round cyan;
}

#current_file {
    width: 100%;

    margin-top: 1;
    margin-bottom: 1;

    padding: 1;

    border: round cyan;
}

#chunk_count {
    width: 100%;

    margin-top: 1;

    padding: 1;

    border: round cyan;
}