Screen {
    layout: vertical;
    background: #0f0f0f;
    color: #e6e6e6;
}

/* =========================
   MAIN DASHBOARD
   ========================= */

#main-panel {
    width: 100%;
    height: 1fr;

    overflow-y: auto;

    border: solid cyan;

    padding: 1 2;
    margin: 0;

    background: #0f0f0f;
}


/* =========================
   MAIN TITLE
   ========================= */

.title {
    width: 100%;

    content-align: center middle;

    text-style: bold;

    margin-top: 0;
    margin-bottom: 1;

    color: #e6e6e6;
}


/* =========================
   SECTION TITLES
   ========================= */

.section-title {
    width: 100%;

    text-style: bold;

    margin-top: 1;
    margin-bottom: 1;

    padding: 0;

    color: #e6e6e6;
}


/* =========================
   ALIGNMENT DASHBOARD
   ========================= */

#alignment-progress-label {
    width: 100%;

    margin-top: 0;
    margin-bottom: 0;

    color: #e6e6e6;
}


#chunk-pair {
    width: 100%;

    margin-top: 0;
    margin-bottom: 0;

    color: #e6e6e6;
}


#alignment_progress {
    width: 100%;

    margin-top: 0;
    margin-bottom: 1;
}


/* =========================
   GPU STATUS
   ========================= */

#gpu-status,
#gpu-memory,
#gpu-utilization,
#cuda-status {
    width: 100%;

    margin-top: 0;
    margin-bottom: 0;

    padding: 0;

    border: none;

    color: #e6e6e6;
}


/* =========================
   RESULTS
   ========================= */

#cpu-result-title,
#gpu-result-title {
    width: 100%;

    text-style: bold;

    margin-top: 1;
    margin-bottom: 0;

    padding: 0;

    color: #e6e6e6;
}


#cpu-average-time,
#cpu-throughput,
#gpu-average-time,
#gpu-throughput,
#gpu-speedup {
    width: 100%;

    margin-top: 0;
    margin-bottom: 0;

    padding: 0;

    color: #e6e6e6;
}


/* =========================
   GENOME CHUNKING
   ========================= */

#chunk_progress {
    width: 100%;

    margin-top: 0;
    margin-bottom: 1;
}


#status {
    width: 100%;

    margin-top: 0;
    margin-bottom: 0;

    padding: 0;

    border: none;

    color: #e6e6e6;
}


#current_file {
    width: 100%;

    margin-top: 0;
    margin-bottom: 0;

    padding: 0;

    border: none;

    color: #e6e6e6;
}


#chunk_count {
    width: 100%;

    margin-top: 0;
    margin-bottom: 0;

    padding: 0;

    border: none;

    color: #e6e6e6;
}